# --- PostgreSQL (consumed by docker-compose) ---
POSTGRES_USER=anubis
POSTGRES_PASSWORD=change-me-in-prod
POSTGRES_DB=anubis
POSTGRES_PORT=5433
# Optional pgAdmin
PGADMIN_EMAIL=admin@anubis.local
PGADMIN_PASSWORD=admin

# --- MinIO (object storage, consumed by docker-compose) ---
MINIO_ROOT_USER=anubis
MINIO_ROOT_PASSWORD=change-me-in-prod
MINIO_BUCKET=anubis-library
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- ONLYOFFICE Document Server (consumed by docker-compose) ---
ONLYOFFICE_IMAGE=onlyoffice/documentserver:latest
ONLYOFFICE_PORT=8082
ONLYOFFICE_JWT_SECRET=change-me-onlyoffice
ONLYOFFICE_JWT_HEADER=Authorization
