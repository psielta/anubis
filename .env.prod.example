# --- Application ---
ENVIRONMENT=production
SECRET_KEY=

# --- PostgreSQL (anubis-db container) ---
POSTGRES_USER=anubis
POSTGRES_PASSWORD=
POSTGRES_DB=anubis
DATABASE_URL=postgresql+asyncpg://anubis:<url-safe-pw>@anubis-db:5432/anubis

# --- CORS (HTTPS frontend origins) ---
BACKEND_CORS_ORIGINS=["https://mateussalgueiro.com.br","https://www.mateussalgueiro.com.br"]

# --- MinIO (anubis-minio container) ---
MINIO_ROOT_USER=anubis
MINIO_ROOT_PASSWORD=

# --- S3-compatible storage (must match MinIO root creds) ---
S3_ENDPOINT_URL=http://anubis-minio:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=anubis-library
S3_REGION=us-east-1
MAX_UPLOAD_SIZE_MB=250

# --- AI study assistant (Gemini) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# or gemini-3-flash-preview