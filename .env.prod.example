# --- Application ---
ENVIRONMENT=production
SECRET_KEY=

# --- PostgreSQL (anubis-db container) ---
POSTGRES_USER=anubis
POSTGRES_PASSWORD=
POSTGRES_DB=anubis
DATABASE_URL=postgresql+asyncpg://anubis:<url-safe-pw>@anubis-db:5432/anubis

# --- CORS (HTTPS frontend origins) ---
BACKEND_CORS_ORIGINS=["https://mateussalgueiro.com.br","https://www.mateussalgueiro.com.br"]

# --- MinIO (anubis-minio container) ---
MINIO_ROOT_USER=anubis
MINIO_ROOT_PASSWORD=

# --- S3-compatible storage (must match MinIO root creds) ---
S3_ENDPOINT_URL=http://anubis-minio:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=anubis-library
S3_REGION=us-east-1
MAX_UPLOAD_SIZE_MB=250

# --- Redis (anubis-redis container) ---
REDIS_URL=redis://anubis-redis:6379/0

# --- PDF to Markdown conversions ---
PDF_CONVERSION_MAX_UPLOAD_MB=100
PDF_CONVERSION_MAX_PAGES=500
PDF_CONVERSION_TIMEOUT_SECONDS=600
PDF_CONVERSION_CHUNK_MAX_CHARS=10000
PDF_CONVERSION_OUTBOX_MAX_ATTEMPTS=3
PDF_CONVERSION_OUTBOX_LEASE_SECONDS=300
PDF_CONVERSION_OUTBOX_POLL_SECONDS=2.0

# --- AI study assistant + RAG (Gemini) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# or gemini-flash-latest / gemini-3.5-flash
# Embeddings for book RAG — prefer -001 (true batch). -2 is slower (1 text/call).
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- ONLYOFFICE Document Server ---
ONLYOFFICE_IMAGE=onlyoffice/documentserver:latest
ONLYOFFICE_ENABLED=true
ONLYOFFICE_DOCSERVER_PUBLIC_URL=https://office.mateussalgueiro.com.br
ONLYOFFICE_DOCSERVER_INTERNAL_URL=http://anubis-onlyoffice
ONLYOFFICE_JWT_SECRET=
ONLYOFFICE_JWT_HEADER=Authorization
ONLYOFFICE_CALLBACK_BASE_URL=https://api.mateussalgueiro.com.br
ONLYOFFICE_CALLBACK_TOKEN_HOURS=24
ONLYOFFICE_MAX_DOCX_MB=50
