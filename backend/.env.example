PROJECT_NAME=Anubis
API_V1_STR=/api/v1
ENVIRONMENT=development

# Async driver → note the +asyncpg
DATABASE_URL=postgresql+asyncpg://anubis:change-me-in-prod@localhost:5433/anubis

# Security — generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-64-hex-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (Angular dev server)
BACKEND_CORS_ORIGINS=["http://localhost:4200"]

# --- Object storage (MinIO / S3) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=anubis
S3_SECRET_KEY=change-me-in-prod
S3_BUCKET=anubis-library
S3_REGION=us-east-1
MAX_UPLOAD_SIZE_MB=50

# --- AI (Gemini) — study assistant + page translation ---
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# --- ONLYOFFICE Document Server ---
ONLYOFFICE_ENABLED=true
ONLYOFFICE_DOCSERVER_PUBLIC_URL=http://localhost:8082
ONLYOFFICE_DOCSERVER_INTERNAL_URL=
ONLYOFFICE_JWT_SECRET=change-me-onlyoffice
ONLYOFFICE_JWT_HEADER=Authorization
# Use http://host.docker.internal:8000 when the Document Server runs in Docker
# and the backend runs directly on the Windows host.
ONLYOFFICE_CALLBACK_BASE_URL=http://host.docker.internal:8000
ONLYOFFICE_CALLBACK_TOKEN_HOURS=24
ONLYOFFICE_MAX_DOCX_MB=50
